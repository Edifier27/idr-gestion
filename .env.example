# Base de datos Neon (Postgres serverless). Cuando estés en casa:
# 1) creá una DB gratis en neon.tech  2) pegá el connection string acá
DATABASE_URL=

# API de Claude para el parseo del PDF (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Maps para el cálculo de km (recorrido base->domicilio->hecho->regreso)
GOOGLE_MAPS_API_KEY=

# Base fija del liquidador para el cálculo de km
BASE_ORIGEN="General Deheza 527, Avellaneda, Buenos Aires, Argentina"

# Login (Auth.js). Generar con: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob (evidencia: fotos y documentos adjuntos por caso).
# Se crea en el dashboard de Vercel: Storage -> Create -> Blob. Al crearla,
# Vercel agrega esta variable sola al proyecto.
BLOB_READ_WRITE_TOKEN=

# Gmail (enviar mails con adjuntos desde el CRM, usando la casilla corporativa).
# Se crean en console.cloud.google.com: proyecto -> Gmail API habilitada ->
# pantalla de consentimiento (Externo, modo Testing) -> credenciales OAuth
# (Aplicación web, redirect URI https://crm-atm.vercel.app/api/gmail/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
